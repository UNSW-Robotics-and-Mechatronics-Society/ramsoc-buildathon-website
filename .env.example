# ---- Supabase (new Buildathon project) ----
# Project settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project settings → API keys → service_role / secret key. SERVER ONLY — never expose.
SUPABASE_SECRET_KEY=

# ---- Clerk ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep these in sync with the routes in src/app/path.ts
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/2026/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/2026/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/2026/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/2026/onboarding

# ---- Square ----
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# sandbox | production
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must EXACTLY match the URL registered in the Square dashboard — it is part of the HMAC.
SQUARE_WEBHOOK_URL=https://buildathon.ramsocunsw.org/api/square-webhook
# Entry fee in CENTS. 5000 = $50.00 per team.
NEXT_PUBLIC_TEAM_PRICE=5000

# ---- Admin portal ----
# Shared password for /2026/admin. Use a long random string.
ADMIN_PASSWORD=
